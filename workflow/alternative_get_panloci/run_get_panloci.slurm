#!/bin/bash
#SBATCH --job-name=get_panloci
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err
#SBATCH --time=200:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=32
#SBATCH --mem=64G
#SBATCH --partition=low

set -euo pipefail

# Find the pipeline (PIPELINE_DIR, else this checkout, else above the submit folder), then load
# lib/slurm_common.sh: PROJECT_DIR, OUTPUT_DIR / STEPNN_OUT (ALT_PANLOCI_OUT), pipeline_config.sh, src/ on PYTHONPATH
_pd="${PIPELINE_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
[[ -f "$_pd/lib/slurm_common.sh" ]] || { _pd="${SLURM_SUBMIT_DIR:-$PWD}"; while [[ "$_pd" != / && ! -f "$_pd/lib/slurm_common.sh" ]]; do _pd="$(dirname "$_pd")"; done; }
source "$_pd/lib/slurm_common.sh" || { echo "ERROR: pipeline not found - export PIPELINE_DIR=/path/to/pangenome-pipeline" >&2; exit 1; }

# ==============================================================================
# GET_PANLOCI CDS-SPAN PIPELINE CONFIGURATION
# ==============================================================================

# Main execution directory containing samples.tsv and the
# Cactus output directory generated by Step 0. Default: $ALT_PANLOCI_OUT
# (output/alternative_get_panloci/ in the project folder); set RUN_DIR to use another.
RUN_DIR="${RUN_DIR:-$ALT_PANLOCI_OUT}"

# Inputs and software.
SAMPLES_TSV="samples.tsv"
CACTUS_SIF="/path/to/cactus.sif"

# HAL file generated by step0_run_cactus_pangenome.slurm.
PANGENOME_HAL="${RUN_DIR}/cactus_output/pangenome.full.hal"

# Output directories.
CANDIDATE_DIR="${RUN_DIR}/candidate_transfers"
VALIDATION_DIR="${RUN_DIR}/validation"
CATALOGUE_DIR="${RUN_DIR}/panlocus_catalogue"

# Classification thresholds.
PRESENT_COV="0.50"
PRESENT_ID="50.0"
PARTIAL_COV="0.30"
PARTIAL_ID="30.0"
NATIVE_OVERLAP="0.50"

# Coordinate merging.
MERGE_GAP="5000"

# Storage path to bind inside the Apptainer/Singularity container.
APPTAINER_BIND_PATH="/path/to/storage"

# ==============================================================================
# ENVIRONMENT
# ==============================================================================

mkdir -p "${RUN_DIR}"
cd "${RUN_DIR}"

if [[ ! -f "${SAMPLES_TSV}" ]]; then
    echo "[ERROR] Samples table not found: ${RUN_DIR}/${SAMPLES_TSV}" >&2
    exit 1
fi

if [[ ! -f "${PANGENOME_HAL}" ]]; then
    echo "[ERROR] Pangenome HAL not found: ${PANGENOME_HAL}" >&2
    echo "[ERROR] Run step0_run_cactus_pangenome.slurm first, or update PANGENOME_HAL." >&2
    exit 1
fi

if [[ ! -f "${CACTUS_SIF}" ]]; then
    echo "[ERROR] Cactus SIF image not found: ${CACTUS_SIF}" >&2
    exit 1
fi

# Bind the storage volume into Apptainer/Singularity.
export APPTAINER_BIND="${APPTAINER_BIND_PATH}"

# Store Apptainer temporary and cache files inside the run directory.
mkdir -p ./apptainer_tmp ./apptainer_cache
export APPTAINER_TMPDIR="$(pwd)/apptainer_tmp"
export APPTAINER_CACHEDIR="$(pwd)/apptainer_cache"

# Some cluster module systems read environment variables during activation.
# Define common variables and disable nounset only while loading the module.
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"
export LD_PRELOAD="${LD_PRELOAD:-}"

PYTHON_MODULE="${PYTHON_MODULE:-python/3.11.9}"
set +u
module load "${PYTHON_MODULE}"
set -u
PYTHON_BIN="${PYTHON_BIN:-$(command -v python3)}"

"${PYTHON_BIN}" - <<'PY'
import sys

if sys.version_info < (3, 8):
    raise SystemExit(
        f"[ERROR] Python >= 3.8 is required, but {sys.executable} is "
        f"{sys.version.split()[0]}"
    )
PY

echo "======================================================================"
echo " Sequential get_panloci pipeline with CDS-span gene coordinates"
echo "======================================================================"
echo "Run directory:       ${RUN_DIR}"
echo "Samples table:       ${SAMPLES_TSV}"
echo "HAL:                 ${PANGENOME_HAL}"
echo "Cactus image:        ${CACTUS_SIF}"
echo "Output run dir:      ${RUN_DIR}"
echo "PRESENT cutoffs:     coverage >= ${PRESENT_COV}, identity >= ${PRESENT_ID}"
echo "PARTIAL cutoffs:     coverage >= ${PARTIAL_COV}, identity >= ${PARTIAL_ID}"
echo "Native overlap:      ${NATIVE_OVERLAP}"
echo "Merge gap:           ${MERGE_GAP} bp"
echo "APPTAINER_BIND:      ${APPTAINER_BIND}"
echo "Python executable:   ${PYTHON_BIN}"
echo "======================================================================"

echo "[step1] Preparing seed panlocus transfers"
"${PYTHON_BIN}" -m pangenome_pipeline.alternative_get_panloci.step1_prepare_seed_transfers \
    --samples "${SAMPLES_TSV}" \
    --hal "${PANGENOME_HAL}" \
    --cactus-img "${CACTUS_SIF}" \
    --outdir "${CANDIDATE_DIR}" \
    --gap "${MERGE_GAP}"

echo "[step2] Validating seed transfers"
"${PYTHON_BIN}" -m pangenome_pipeline.alternative_get_panloci.step2_validate_transfers \
    --samples "${SAMPLES_TSV}" \
    --beddir "${CANDIDATE_DIR}" \
    --outdir "${VALIDATION_DIR}" \
    --cactus-img "${CACTUS_SIF}" \
    --present-cov-cutoff "${PRESENT_COV}" \
    --present-id-cutoff "${PRESENT_ID}" \
    --partial-cov-cutoff "${PARTIAL_COV}" \
    --partial-id-cutoff "${PARTIAL_ID}"

echo "[step3] Building sequential panlocus catalogue"
"${PYTHON_BIN}" -m pangenome_pipeline.alternative_get_panloci.step3_build_panlocus_catalogue \
    --samples "${SAMPLES_TSV}" \
    --beddir "${CANDIDATE_DIR}" \
    --valdir "${VALIDATION_DIR}" \
    --outdir "${CATALOGUE_DIR}" \
    --hal "${PANGENOME_HAL}" \
    --cactus-img "${CACTUS_SIF}" \
    --gap "${MERGE_GAP}" \
    --native-overlap-cutoff "${NATIVE_OVERLAP}" \
    --present-cov-cutoff "${PRESENT_COV}" \
    --present-id-cutoff "${PRESENT_ID}" \
    --partial-cov-cutoff "${PARTIAL_COV}" \
    --partial-id-cutoff "${PARTIAL_ID}"

echo "[done] get_panloci pipeline completed"
